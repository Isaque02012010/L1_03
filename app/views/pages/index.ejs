<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reajuste Salarial</title>
    <style>
        .alerta-erro {
            color: #721c24;
            background-color: #f8d7da;
            border: 1px solid #f5c6cb;
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 4px;
        }
    </style>
</head>
<body>
 
    <h1>Reajuste Salarial</h1>
 
    <% if (typeof erros !== 'undefined' && erros && erros.length > 0) { %>
        <div class="alerta-erro">
            <strong>Por favor, corrija os seguintes erros:</strong>
            <ul>
                <% erros.forEach(function(erro) { %>
                    <li><%= erro.msg %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <form action="/reajuste" method="post">
 
        <label for="salario">Digite o salário:</label><br>
 
        <input
            type="text"
            name="salario"
            id="salario"
            value="<%= valores.salario %>"
        ><br><br>
 
        <button type="submit">Calcular</button>
 
    </form>
 
    <hr>
 
    <% if(retorno){ %>
 
        <h2>Resultado</h2>
 
        <p>Salário antes do reajuste: R$ <%= retorno.salario %></p>
 
        <p>Percentual aplicado: <%= retorno.percentual %>%</p>
 
        <p>Valor do aumento: R$ <%= retorno.aumento %></p>
 
        <p>Novo salário: R$ <%= retorno.novoSalario %></p>
 
    <% } else { %>
 
        <h2>Nenhum cálculo realizado.</h2>
 
    <% } %>
 
</body>
</html>
